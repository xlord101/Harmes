# LLM API Keys (Set at least one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hermes_agent?retryWrites=true&w=majority
MONGODB_DB_NAME=hermes_agent
MONGODB_COLLECTION_NAME=issues

# GitHub API Credentials
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Credentials (For daily mobile alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
