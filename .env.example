# LLM API Keys (Set at least one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas Credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hermes_agent?retryWrites=true&w=majority
MONGODB_DB_NAME=hermes_agent
MONGODB_COLLECTION_NAME=issues

# GitHub API Credentials
GITHUB_TOKEN=your_github_personal_access_token_here

# LinkedIn API Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_urn_here
